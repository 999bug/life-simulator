    ],
    "category": "career",
    "title": "狱中考验",
    "text": "劳动改造的车间里，你分到了一条流水线。车间主任说，干得好能评先进，减刑材料上就多一行字。休息时，管教把一摞旧书放在窗台上——有人要了教材，有人要了武侠小说，也有人什么都不看，盯着天花板数时间。",
    "choices": [
      {
        "text": "埋头干活，攒减刑表现",
        "effects": {
          "discipline": 6,
          "health": 4,
          "happiness": -3
        },
        "flags_add": []
      },
      {
        "text": "向管教借教材，狱中自考",
        "effects": {
          "learning": 9,
          "ambition": 5
        },
        "flags_add": []
      },
      {
        "text": "出工不出力，混一天是一天",
        "effects": {
          "freedom": 5,
          "discipline": -6
        },
        "flags_add": []
      }
    ],
    "conditions": {
      "has_flags": [
        "jailed"
      ],
      "not_flags": [],
