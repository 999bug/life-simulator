        "flags_add": [
          "jailed"
        ],
        "personality": [
          "rational"
        ]
      },
      {
        "text": "咬死不认，把锅甩给「只是打工的」",
        "effects": {
          "strategy": 6,
          "empathy": -8
        },
        "flags_add": [
          "jailed"
        ],
        "personality": [
          "selfish"
        ]
      },
      {
        "text": "花重金请律师周旋，能拖则拖",
        "effects": {
