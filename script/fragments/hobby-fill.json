        "effects": { "art": 8, "happiness": 4, "social": 3 },
        "flags_add": ["artist_life"]
      },
      {
        "text": "认认真真地把每一片叶子都补上",
        "effects": { "art": 5, "focus": 5, "creativity": 3 },
        "flags_add": []
