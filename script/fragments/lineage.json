  {
    "id": "lineage_0014",
    "age_range": [13, 13],
    "category": "health",
    "title": "饭桌上的从医争论",
    "text": "饭桌上聊起将来的志向，你说想学医。当医生的长辈放下筷子，说了半宿这一行的苦：值班、考核、连轴转。最后却话锋一转：「但你要是真想，我不拦你——救人的感觉，什么都换不来。」",
    "choices": [
      { "text": "更坚定了：苦我也要学", "effects": { "ambition": 3, "intelligence": 2 }, "flags_add": [] },
      { "text": "有点犹豫，先把生物学好再说", "effects": { "intelligence": 2, "caution": 2 }, "flags_add": [] },
      { "text": "被吓住了，还是想点别的出路吧", "effects": { "independence": 2, "happiness": 1 }, "flags_add": [] }
    ],
    "conditions": { "has_flags": ["parent_doctor"], "not_flags": [], "min_attrs": {}, "max_attrs": {} }
