  { "id": "sport_0013", "choices": [
    { "text": "虚心跟老队长学，练了一下午找手感", "personality": ["rational"] },
    { "text": "坐场边看他们打，输赢无所谓，热闹就好", "personality": ["cautious"] },
    { "text": "买了一套自己的球杆，正式加入球队", "personality": ["adventurous"] }
  ]},
  { "id": "elder_0102", "choices": [
    { "text": "翻出相册，把孙辈从小到大的照片看了一遍又一遍", "personality": ["emotional"] },
    { "text": "惦记着孙辈，又忍不住念叨儿子儿媳工作太忙", "personality": ["cautious"] }
  ]},
  { "id": "elder_62", "choices": [
    { "text": "「这是我见过最漂亮的小家伙。」", "personality": ["emotional"] },
    { "text": "悄悄给孩子的教育基金存了一笔", "personality": ["rational"] },
