  {
    "id": "lineage_0013",
    "age_range": [12, 12],
    "category": "education",
    "title": "复读那一年的照片",
    "text": "相册最深处夹着一张旧照片：年轻时的长辈站在复读班教室门口，眼神倔强。长辈说，第一次高考落榜，是村里第一个选择复读的人，那一年所有人都在看笑话。第二年，长辈把录取通知书拍在了那些人面前。",
    "choices": [
      { "text": "问长辈：那一年是怎么熬过来的", "effects": { "persistence": 3, "resilience": 2 }, "flags_add": [] },
      { "text": "把照片里的眼神记在心里", "effects": { "willpower": 2, "self_reliance": 2 }, "flags_add": [] },
      { "text": "心想：原来大人也失败过啊", "effects": { "emotion": 2, "empathy": 1 }, "flags_add": [] }
    ],
    "conditions": { "has_flags": ["parent_retake"], "not_flags": [], "min_attrs": {}, "max_attrs": {} }
