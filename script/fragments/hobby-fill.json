      {
        "text": "画完卷起画纸，跑去和小朋友玩滑梯",
        "effects": { "social": 6, "happiness": 4, "art": 3 },
        "flags_add": []
      }
    ],
    "conditions": { "has_flags": [], "not_flags": [], "min_attrs": {}, "max_attrs": {} }
