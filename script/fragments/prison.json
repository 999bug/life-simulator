  {
    "id": "prison_0036",
    "age_range": [
      36,
      36
    ],
    "category": "friend",
    "title": "狱中百态",
    "text": "放风的时候，院子里蹲着几拨人。靠墙那位是个老江湖，说话带江湖气，指给你听「这里谁说了算」；角落里那个文弱书生判了六年，天天捧着一本书；还有位老实巴交的大哥，每个探视日都有人来看他。你站在场中央，不知道该往哪边走。",
    "choices": [
      {
        "text": "跟老江湖称兄道弟，学点门道",
        "effects": {
          "social": 7,
          "risk": 5,
          "empathy": -4
        },
        "flags_add": [],
        "personality": [
          "selfish"
        ]
      },
      {
        "text": "独来独往，不站队也不得罪人",
        "effects": {
          "independence": 6,
          "social": -5
        },
        "flags_add": [],
        "personality": [
          "cautious"
        ]
      },
      {
        "text": "跟那位读书人借书，把日子过起来",
        "effects": {
          "learning": 7,
          "friendship": 4
        },
        "flags_add": []
      }
    ],
    "conditions": {
      "has_flags": [
        "jailed"
