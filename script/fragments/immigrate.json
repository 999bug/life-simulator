[
  {
    "id": "immi_0001",
    "age_range": [56, 56],
    "category": "personality",
    "title": "世界那么大",
    "text": "某个寻常的晚上，你刷到老同学旅居海外的视频：窗外的海湾、面包房飘出的黄油香、听不懂却安安静静的日子。你关掉视频，对着阳台发了很久的呆。体检报告上写着「各项指标正常」，存折上那串数字你数了两遍——原来日子，还可以换一种过法。",
    "choices": [
      { "text": "翻出存折看了看，给老同学发消息：帮我问问，那边怎么住", "effects": { "freedom": 8, "money": -8, "independence": 6 }, "flags_add": ["immigrate_idea"] },
      { "text": "把视频投到电视上，喊老伴过来一起看", "effects": { "family_relation": 6, "happiness": 4, "saving": 4 }, "flags_add": ["immigrate_idea"] },
      { "text": "关掉视频，把存折放回抽屉：这把年纪，别折腾了", "effects": { "stability": 5, "money": 4 }, "flags_add": [] }
    ],
    "conditions": { "has_flags": [], "not_flags": [], "min_attrs": { "money": 40 }, "max_attrs": {} }
  },
