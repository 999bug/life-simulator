    { "text": "把信收进抽屉，改天再说", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "elderwarm_0002", "choices": [
    { "text": "开一瓶存了多年的老酒，边喝边聊", "personality": ["emotional"] },
    { "text": "约他常来，把没聊完的话都聊完", "personality": ["rational"] },
    { "personality": null }
  ]},
  { "id": "hobby_0015", "choices": [
    { "text": "把果子挨家分给邻居，和街坊们一起尝鲜", "personality": ["altruistic"] },
    { "text": "学着酿一坛石榴酒，封起来等冬天开", "personality": ["rational"] },
    { "text": "坐在树下剥石榴，慢慢地回味这些年", "personality": ["emotional"] }
