  { "id": "elder_0078", "choices": [
    { "text": "把菜园打理得漂漂亮亮", "personality": ["rational"] },
    { "text": "教邻居也种一片", "personality": ["altruistic"] },
    { "text": "种了几天就懒了", "personality": ["cautious"] }
  ]},
  { "id": "elderwarm_0003", "choices": [
    { "text": "和老伴一张张辨认照片里的人", "personality": ["emotional"] },
    { "text": "把照片翻拍下来传给家人", "personality": ["rational"] },
