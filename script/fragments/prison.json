    ],
    "category": "personality",
    "title": "改造抉择",
    "text": "深夜，熄灯号响过之后，你躺在铁架床上盯着天花板。同铺的老江湖白天又凑过来，说出去之后「带你发财」；白天管教讲的那堂法制课，却一直在你脑子里转。还有两年刑期，出去以后，是重新做人，还是重操旧业？窗外只有放风场那盏孤零零的路灯。",
    "choices": [
      {
        "text": "写下检讨书，真心悔过",
        "effects": {
          "responsibility": 8,
          "self_control": 5
        },
        "flags_add": [],
        "personality": [
          "altruistic"
        ]
      },
      {
        "text": "数着刑期熬日子，不动任何念头",
        "effects": {
          "patience": 5,
          "happiness": -3
        },
        "flags_add": [],
        "personality": [
          "cautious"
        ]
      },
      {
        "text": "盘算出去后的「生意」，跟老江湖越走越近",
        "effects": {
          "strategy": 6,
          "risk": 6,
          "empathy": -6
        },
        "flags_add": [],
        "personality": [
          "selfish"
        ]
      }
