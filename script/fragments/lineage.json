  {
    "id": "lineage_0010",
    "age_range": [8, 8],
    "category": "personality",
    "title": "豆腐块被子",
    "text": "家里规矩严：被子要叠成方方正正的豆腐块，东西用完必须归位。那是长辈从部队带回来的习惯。今天你的被子终于叠出了棱角，长辈检查时在床头站了很久，郑重地说了句：「合格。」",
    "choices": [
      { "text": "明天还要叠得更方正", "effects": { "discipline": 3, "self_control": 1 }, "flags_add": [] },
      { "text": "问长辈部队里的故事", "effects": { "curiosity": 2, "family_relation": 1 }, "flags_add": [] },
      { "text": "偷偷给自己也定了三条家规", "effects": { "responsibility": 2, "planning": 1 }, "flags_add": [] }
    ],
    "conditions": { "has_flags": ["parent_military_flag"], "not_flags": [], "min_attrs": {}, "max_attrs": {} }
  },
  {
    "id": "lineage_0011",
    "age_range": [11, 11],
    "category": "education",
    "title": "书房里的名校校徽",
    "text": "家里书柜最上层摆着一枚校徽，擦得一尘不染。那是长辈当年读过的大学，全国数一数二。长辈很少提当年多风光，只说：「那四年，教会我怎么把书读进去。」你踮起脚看了很久，暗暗记下了校徽上的名字。",
    "choices": [
      { "text": "问长辈：要考多少分才能戴上它", "effects": { "intelligence": 3, "ambition": 2 }, "flags_add": [] },
      { "text": "把校徽的名字写进自己的愿望清单", "effects": { "ambition": 3, "discipline": 1 }, "flags_add": [] },
      { "text": "觉得压力好大，还是先去玩一会儿", "effects": { "happiness": 2, "pressure": -2 }, "flags_add": [] }
    ],
    "conditions": { "has_flags": ["parent_top_university"], "not_flags": [], "min_attrs": {}, "max_attrs": {} }
  },
  {
    "id": "lineage_0012",
    "age_range": [12, 12],
    "category": "education",
    "title": "家里的第一张文凭",
    "text": "搬家整理旧物，你翻出一张压箱底的毕业证书——家里第一代大学生的文凭。长辈说，当年全村就出了这一个大学生，报到那天全村的乡亲送到村口。你摸着那张泛黄的纸，第一次觉得「上大学」三个字是有分量的。",
    "choices": [
      { "text": "问长辈当年是怎么苦读出来的", "effects": { "intelligence": 2, "persistence": 2 }, "flags_add": [] },
      { "text": "暗下决心：家里第二张文凭由我来拿", "effects": { "ambition": 3, "self_reliance": 1 }, "flags_add": [] },
      { "text": "把文凭小心放回原处，像放回一件传家宝", "effects": { "gratitude": 2, "emotion": 1 }, "flags_add": [] }
    ],
    "conditions": { "has_flags": ["parent_went_to_college"], "not_flags": [], "min_attrs": {}, "max_attrs": {} }
