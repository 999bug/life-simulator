      38
    ],
    "category": "family",
    "title": "探视日",
    "text": "探视日，家属区排起了长队。轮到你的名字时，你看见玻璃那边坐着母亲——她头发白了许多，隔着话筒直问你吃得饱不饱。旁边还坐着那个人，低着头不看你。规定时间只有二十分钟，话筒很重，你有点握不住。",
    "choices": [
      {
        "text": "眼泪没忍住，跟家人保证好好改造",
        "effects": {
          "empathy": 8,
          "happiness": 5
        },
        "flags_add": [],
        "personality": [
          "emotional"
        ]
      },
      {
        "text": "笑着报平安，让他们别担心",
        "effects": {
          "emotion_control": 7,
          "family_relation": 4
        },
        "flags_add": [],
        "personality": [
          "rational"
        ]
      },
      {
        "text": "觉得自己没脸见人，说「下次别来了」",
        "effects": {
          "happiness": -8,
          "introversion": 5
        },
        "flags_add": []
      }
    ],
