    { "personality": null },
    { "text": "「捐一部分意思意思吧，我也要留点养老钱。」", "personality": ["cautious"] },
    { "text": "「我自己的日子也就这样，哪管得了别人。」", "personality": ["selfish"] }
  ]},
  { "id": "elder_31", "choices": [
    { "text": "「走吧，这回补上欠你的蜜月。」", "personality": ["emotional"] },
    { "text": "「先去城里逛逛，再去海边，反正不赶时间。」", "personality": ["adventurous"] },
    { "text": "「花这个钱干啥，在家看看电视也挺好。」", "personality": ["cautious"] }
  ]},
  { "id": "echo_0007", "choices": [
    { "text": "跟着队伍打太极，一天不落", "personality": ["rational"] },
    { "text": "先从快走开始，量力而行", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "love_0006", "choices": [
    { "text": "笑着应：「风雨无阻，我家狗都替你答应了」", "personality": ["emotional"] },
    { "text": "认真地说：「好，我也想多听听你的故事」", "personality": ["rational"] },
    { "text": "犹豫了一下，低头踢了踢石子：「到时候再说吧」", "personality": ["cautious"] }
  ]},
  { "id": "elder_32", "choices": [
    { "text": "「谢谢你们。这辈子有你们，值了。」", "personality": ["emotional"] },
    { "text": "「别破费了，以后生日都回家吃碗面就行。」", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "elder_33", "choices": [
    { "text": "「每年重阳都来爬，爬到爬不动为止。」", "personality": ["adventurous"] },
    { "text": "「下山请你们吃烤鸭。」一家人其乐融融", "personality": ["emotional"] },
    { "text": "「能爬上来一次算一次，日子过一天赚一天。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_34", "choices": [
    { "text": "「治病要紧。钱没了可以再想别的办法。」", "personality": ["rational"] },
    { "text": "「能省则省，能出院就出院，不住了。」", "personality": ["cautious"] },
    { "text": "「一把年纪了，给孩子们省点钱吧。」", "personality": ["altruistic"] }
  ]},
  { "id": "elder_35", "choices": [
    { "text": "「多印几本，每个孩子都送一本。」", "personality": ["altruistic"] },
    { "text": "试着联系出版社，想让更多人看看那一代人的故事", "personality": ["adventurous"] },
    { "text": "「写完就完了，放起来吧。」", "personality": ["cautious"] }
  ]},
  { "id": "music_0005", "choices": [
    { "text": "教孙辈们弹这首曲子", "personality": ["altruistic"] },
    { "text": "办一场家庭小音乐会，把家人都叫来", "personality": ["emotional"] },
    { "personality": null }
  ]},
  { "id": "elder_04", "choices": [
    { "text": "「钱很重要，但它只是工具。真正富足的是内心。」", "personality": ["rational"] },
    { "text": "「运气。我赶上了好时代。能帮到别人的时候尽量帮。」", "personality": ["altruistic"] }
  ]},
  { "id": "elder_05", "choices": [
    { "text": "「钱少的时候，爱就要多。这辈子值了。」", "personality": ["emotional"] },
    { "text": "「如果重来一次……可能还是老样子吧。」", "personality": ["rational"] }
  ]},
  { "id": "elder_06", "choices": [
    { "text": "「爱是最值得的事。勇敢去爱，别怕受伤。」", "personality": ["emotional"] },
    { "text": "「做自己。人生不长，不要活在别人的期待里。」", "personality": ["adventurous"] },
    { "text": "「钱和健康，健康更重要。可惜年轻时不明白。」", "personality": ["rational"] },
    { "text": "「如果能重来一次……」", "personality": ["cautious"] }
  ]},
  { "id": "elder_36", "choices": [
    { "text": "「一个人也要把日子过好。」养了只猫，给它取了个名", "personality": ["rational"] },
    { "text": "「一个人的清静，也是一种福气。」", "personality": ["cautious"] },
    { "text": "「要是有人能说说话就好了。」", "personality": ["emotional"] }
  ]},
  { "id": "elder_37", "choices": [
    { "text": "「把该交代的一次性交代清楚，我才能安心。」", "personality": ["rational"] },
    { "text": "「这些年攒的邮票都留给你，记得好好收着。」", "personality": ["emotional"] },
    { "text": "「改来改去麻烦，就这样吧。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_38", "choices": [
    { "text": "「做人要正直，走自己的路。」", "personality": ["rational"] },
    { "text": "「别怕犯错，爷爷这一辈子，错事也干了不少，照样过来了。」", "personality": ["emotional"] },
    { "text": "「年轻真好。你们的路，比我们当年宽多了。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_39", "choices": [
    { "text": "「没事，有我呢。」日夜守在病床边，学喂饭、学按摩", "personality": ["altruistic"] },
    { "text": "请了护工，自己白天黑夜两头跑", "personality": ["rational"] },
    { "text": "「这日子，真不知道怎么过下去了。」", "personality": ["emotional"] }
  ]},
  { "id": "hobby_0014", "choices": [
    { "text": "潜心研究棋谱，成了凉亭里的常胜将军", "personality": ["rational"] },
    { "text": "输赢都不恼，就爱这份热闹", "personality": ["emotional"] },
    { "text": "教会小孙子下棋，爷孙俩在树下对弈", "personality": ["altruistic"] }
  ]},
  { "id": "sport_0012", "choices": [
    { "text": "陪老王多走了一圈，听他聊老伴的病情", "personality": ["altruistic"] },
    { "text": "今天想走快些，一个人走完三圈", "personality": ["rational"] },
    { "personality": null }
  ]},
  { "id": "elder_40", "choices": [
    { "text": "「人少了，更要聚。只要还能走，我就来。」", "personality": ["emotional"] },
    { "text": "「想见的人，平时就该多见见。」散场后去看望住院的老友", "personality": ["altruistic"] },
    { "personality": null }
  ]},
  { "id": "elder_41", "choices": [
    { "text": "「我回去跟孩子们商量商量再说。」出门就给儿子/女儿打了个电话", "personality": ["rational"] },
    { "text": "「钱是小事，身体是大事。」刷了卡，买了三盒", "personality": ["emotional"] },
    { "text": "「别忽悠我，我这辈子见过的骗局比你吃过的饭都多。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_42", "choices": [
    { "text": "「我就不信学不会。」回家偷偷跟着录音练", "personality": ["adventurous"] },
    { "text": "「反正大家唱我也跟着唱，图个乐。」", "personality": ["cautious"] },
    { "text": "「嗓子不行了，不唱了，丢人。」", "personality": ["emotional"] }
  ]},
  { "id": "elder_43", "choices": [
    { "text": "「一家人，就该是这个样子。」", "personality": ["emotional"] },
    { "text": "「以前的事就别提了，往后的日子好好过。」", "personality": ["rational"] },
    { "text": "「有时候想想，当初要是早点说开就好了。」", "personality": ["cautious"] }
  ]},
  { "id": "echo_0025", "choices": [
    { "text": "敬这一路的风风雨雨", "personality": ["emotional"] },
    { "personality": null },
    { "text": "平平淡淡才是真，在家下碗面", "personality": ["cautious"] }
  ]},
  { "id": "tech_0011", "choices": [
    { "text": "我定了每周固定时间视频，还学会了截屏存照片", "personality": ["rational"] },
    { "text": "我怕拨错号码，总是等他们打过来", "personality": ["cautious"] },
    { "text": "我研究出了美颜功能，全家都说我变年轻了", "personality": ["emotional"] }
  ]},
  { "id": "elder_07", "choices": [
    { "text": "「我这辈子最骄傲的不是赚了多少钱，而是帮了多少人。」", "personality": ["altruistic"] },
    { "text": "「钱是手段，不是目的。可惜很多人一辈子都没搞明白。」", "personality": ["rational"] }
  ]},
  { "id": "elder_08", "choices": [
    { "text": "「日子苦是苦了点，但能走到今天也是一种本事。」", "personality": ["rational"] },
    { "text": "「下辈子，可能该对自己好一点。」", "personality": ["emotional"] }
  ]},
  { "id": "elder_44", "choices": [
    { "text": "「房子给你们，我住哪儿都行。老了，看得开了。」", "personality": ["altruistic"] },
    { "text": "「过户归过户，我们老两口得留一间自己住。」", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "elder_45", "choices": [
    { "text": "「医生的话要听，但也不能全听。」换了双好鞋，量力而行", "personality": ["rational"] },
    { "text": "「老了就是老了，认了。」以后都让子女接送", "personality": ["cautious"] },
    { "text": "「多走一步，就是赚一步。」", "personality": ["adventurous"] }
  ]},
  { "id": "elder_46", "choices": [
    { "text": "「我还能干几年，你慢慢学。」手把手地带新人", "personality": ["altruistic"] },
    { "text": "「我身体不如以前了，这摊子，以后就交给你们年轻人了。」", "personality": ["rational"] },
    { "personality": null }
  ]},
  { "id": "elder_47", "choices": [
    { "text": "「没实现的不遗憾。年轻时敢想，就很了不起了。」", "personality": ["rational"] },
    { "text": "「趁还走得动，去看看海吧。」第二天就报了旅行团", "personality": ["adventurous"] },
    { "text": "「想这些有什么用，日子不还得照常过。」把匣子又盖上了", "personality": ["cautious"] }
  ]},
  { "id": "love_0007", "choices": [
    { "text": "把削好的苹果递给TA：「快点好起来，家里花还等你浇呢」", "personality": ["emotional"] },
    { "text": "夜里留在病房陪床，握着TA的手睡了一宿", "personality": ["altruistic"] },
    { "text": "回家休息一夜，第二天天没亮又赶到医院", "personality": ["rational"] }
  ]},
  { "id": "elder_48", "choices": [
    { "text": "「好样的！爷爷/奶奶给你包个大红包！」", "personality": ["emotional"] },
    { "text": "「好好念书，别辜负了这机会。」", "personality": ["rational"] },
    { "text": "「你长大了，以后的路，就靠你自己走了。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_49", "choices": [
    { "text": "「你走了，我也得替你把日子过下去。」", "personality": ["rational"] },
    { "text": "每天去墓园坐一会儿，跟TA说说话", "personality": ["emotional"] },
    { "personality": null }
  ]},
  { "id": "elder_50", "choices": [
    { "text": "「睡不着就睡不着，起来听会儿广播。」", "personality": ["rational"] },
    { "text": "天亮给儿子/女儿打个电话，听听TA们的声音", "personality": ["emotional"] },
    { "personality": null }
  ]},
  { "id": "elder_51", "choices": [
    { "text": "「都安排妥当了，我走也走得安心。」", "personality": ["rational"] },
    { "text": "把清单复印了一份，亲手交给儿子/女儿", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "elder_52", "choices": [
    { "text": "「好兄弟，下辈子还做朋友。」", "personality": ["emotional"] },
    { "text": "「你交代的事，我都记下了。放心。」", "personality": ["altruistic"] },
    { "personality": null }
  ]},
  { "id": "love_0008", "choices": [
    { "text": "伸出手指让TA戴上：「五十年哪够，我要六十年」", "personality": ["emotional"] },
    { "text": "把戒指小心收进贴身衣袋，什么都没说，只是笑了", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "elder_53", "choices": [
    { "text": "「读万卷书，行万里路，这辈子值了。」", "personality": ["rational"] },
    { "text": "「趁还走得动，再出去走一趟吧。」", "personality": ["adventurous"] },
    { "text": "「照片都在，人老了。看着看着，眼睛就花了。」", "personality": ["emotional"] }
  ]},
  { "id": "elder_54", "choices": [
    { "text": "「阎王爷要是来收我，我就跟它商量商量，再让我多活几年。」", "personality": ["adventurous"] },
    { "text": "「这辈子没什么遗憾了。就是舍不得你们。」", "personality": ["emotional"] },
    { "text": "「早知道多注意身体就好了。你们一定要爱惜自己。」", "personality": ["altruistic"] }
  ]},
  { "id": "elder_55", "choices": [
    { "text": "「这照片，挂客厅正中间。」", "personality": ["emotional"] },
    { "text": "「以后每年都拍一张。」", "personality": ["rational"] },
    { "personality": null }
  ]},
  { "id": "elder_56", "choices": [
    { "text": "「这五十年，辛苦你了。」牵起TA的手，就像五十年前那样", "personality": ["emotional"] },
    { "personality": null },
    { "text": "「半个世纪，说短不短，说长也真长。」", "personality": ["rational"] }
  ]},
  { "id": "elder_09", "choices": [
    { "text": "「希望你们都能好好爱自己。」在心里默默许愿", "personality": ["altruistic"] },
    { "text": "「没什么愿望了。这样就很好。」", "personality": ["cautious"] },
    { "text": "「多希望还能再活一遍……」", "personality": ["emotional"] }
  ]},
  { "id": "elder_10", "choices": [
    { "text": "「不后悔。自由是一生最好的伴侣。」", "personality": ["adventurous"] },
    { "text": "「有时候也会想——如果当初……」", "personality": ["emotional"] }
  ]},
  { "id": "elder_57", "choices": [
    { "text": "「这封信，就是爷爷/奶奶留给你们的宝贝。」", "personality": ["emotional"] },
    { "text": "「一辈子太短，能留下的，也就是这些字了。」", "personality": ["rational"] },
    { "text": "「写了也没人看，算了吧。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_58", "choices": [
    { "text": "「捐一半，留一半。孩子们的日子，也要顾着。」", "personality": ["rational"] },
    { "text": "「全捐了。钱生不带来，死不带去，留给他们比留给我有用。」", "personality": ["altruistic"] },
    { "text": "「算了，还是都留给孩子们吧，世道艰难。」", "personality": ["cautious"] }
  ]},
  { "id": "elder_59", "choices": [
    { "text": "「该交代的，我都交代过了。你们都要好好的。」", "personality": ["rational"] },
    { "text": "「帮我谢谢所有帮过我的人。这辈子，欠的人情还不完了。」", "personality": ["altruistic"] },
    { "text": "「真想再多陪你们几年啊。」", "personality": ["emotional"] }
  ]},
  { "id": "elder_60", "choices": [
    { "text": "「我这一生，没有遗憾。」", "personality": ["rational"] },
    { "text": "「有些事没做成，但没做成，也是一种活法。」", "personality": ["cautious"] },
    { "personality": null }
  ]},
  { "id": "elderwarm_0001", "choices": [
    { "text": "立刻回信，再寄一张近照", "personality": ["emotional"] },
    { "personality": null },
    { "text": "让孙辈常打视频来", "personality": ["rational"] }
  ]},
  { "id": "elder_0101", "choices": [
    { "text": "认真记下医嘱，从此每天清晨去公园走两圈", "personality": ["rational"] },
    { "text": "嘴上应着，转头就忘了，日子照旧", "personality": ["cautious"] }
  ]},
  { "id": "elder_61", "choices": [
    { "text": "「走一个算一个，活着的人要好好活。」", "personality": ["rational"] },
    { "text": "给老同学打个电话，约出来喝早茶", "personality": ["emotional"] },
    { "text": "把自己关在家里，不想见人", "personality": ["cautious"] }
